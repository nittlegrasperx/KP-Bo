---
import Base from '../layouts/Base.astro';
import CityArt from '../components/CityArt.astro';
import {t,slugs} from '../data';
import {getCollection} from 'astro:content';
export function getStaticPaths(){return ['en','th'].flatMap(lang=>slugs.map(slug=>({params:{path:`${lang}${slug?'/'+slug:''}`},props:{lang,slug}})));}
const {lang,slug}=Astro.props;const d=t[lang];const articles=(await getCollection('articles')).filter(a=>a.data.lang===lang).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const root=`/${lang}/`;const title=slug?`${d.nav[slugs.indexOf(slug)]} — BO / STUDIO`:'BO / STUDIO — Urban Intelligence & Spatial Design';
---
<Base lang={lang} title={title} current={slug}>
{slug==='' ? <>
<section class="v2-hero"><div class="v2-intro"><p class="v2-kicker">URBAN INTELLIGENCE / GEOAI / DIGITAL TWIN / SUSTAINABLE CITIES</p><h1>Beyond<br/>the <em>Map.</em></h1><h2>{lang==='th'?'ออกแบบความฉลาด เพื่อเมืองที่ดีกว่า':'Designing intelligence for better cities.'}</h2><p class="v2-bio">{lang==='th'?'กัลยานี พรพัฒนกุลฑล (โบ) · GeoDesign Manager ผู้เชี่ยวชาญด้านการวางผังเมือง GIS และ Digital Twin เชื่อมโยงข้อมูล เทคโนโลยี และการออกแบบเพื่อการตัดสินใจที่ดีกว่า':'Kanlayanee Pornpatthanakulton (Bo) · GeoDesign Manager. Working at the intersection of urban planning, GIS, digital twins and spatial intelligence to turn complex data into better decisions.'}</p><div class="v2-actions"><a class="v2-primary" href={`${root}projects/`}>{lang==='th'?'สำรวจผลงาน':'Explore My Work'} ↗</a><a class="v2-secondary" href={`${root}writing/`}>{lang==='th'?'อ่านบทความ':'Read My Writing'} ↗</a></div></div><div class="v2-photo"><img src="/images/city-hero.webp" alt="Illustrative city and digital twin visualization"/></div></section>
<section class="v2-disciplines">{(lang==='th'?[['◇','Urban Intelligence','ข้อมูลเมืองสู่การตัดสินใจเชิงกลยุทธ์'],['▥','Digital Twin','บูรณาการข้อมูลเมืองและโครงสร้างพื้นฐาน'],['⌁','GeoAI & Analytics','วิเคราะห์เชิงพื้นที่ด้วย AI'],['◌','Sustainable Futures','สร้างเมืองที่ยืดหยุ่นและยั่งยืน']]:[['◇','Urban Intelligence','Turning spatial data into strategic city decisions.'],['▥','Digital Twin','Integrating people, places and infrastructure.'],['⌁','GeoAI & Analytics','AI and spatial analytics for urban challenges.'],['◌','Sustainable Futures','Designing resilient and low-carbon cities.']]).map(x=><div class="v2-discipline"><span class="v2-symbol">{x[0]}</span><div><h3>{x[1]}</h3><p>{x[2]}</p></div></div>)}</section>
<section class="v2-lower"><div class="v2-projects"><div class="v2-section-heading"><h2>{lang==='th'?'ผลงานคัดสรร':'Featured Projects'}</h2><a href={`${root}projects/`}>VIEW ALL ↗</a></div><div class="v2-project-grid">{[['EECiti Smart IOC','Integrated spatial intelligence for urban development.','project-city'],['Flood Intelligence','Flood risk monitoring and decision support.','project-flood'],['Urban Planning & 3D GIS','Scenario-based city planning and spatial analysis.','project-planning']].map((x,i)=><a class="v2-project" href={`${root}projects/`}><img src={`/images/${x[2]}.webp`} alt={x[0]+' illustrative concept visual'}/><div class="v2-project-text"><small>0{i+1} / SELECTED WORK</small><h3>{x[0]} ↗</h3><p>{x[1]}</p></div></a>)}</div><p class="v2-disclaimer">{lang==='th'?'ภาพประกอบเป็นภาพแนวคิด ไม่ใช่ภาพจากระบบจริง รายละเอียดผลงานอ้างอิงจากประวัติที่ให้มา':'Visuals are conceptual illustrations, not actual project screenshots. Project descriptions are based on the supplied resume.'}</p></div><div class="v2-writing"><div class="v2-section-heading"><h2>{lang==='th'?'บทความล่าสุด':'Latest Writing'}</h2><a href={`${root}writing/`}>VIEW ALL ↗</a></div>{articles.slice(0,3).map((a,i)=><a class="v2-article" href={`${root}writing/${a.id.split('/').pop()}/`}><div class="v2-article-thumb">{i===0?'GIS':i===1?'DT':'AI'}</div><div><small>{a.data.category} / {a.data.date.toISOString().slice(0,10)}</small><h3>{a.data.title}</h3><p>{a.data.description}</p></div></a>)}</div><div class="v2-about"><div class="v2-section-heading"><h2>{lang==='th'?'เกี่ยวกับฉัน':'About Me'}</h2></div><div class="v2-about-graphic">KP<span> / BO</span></div><blockquote>“{lang==='th'?'ข้อมูลที่ดีไม่ควรแค่บอกว่าเกิดอะไรขึ้น แต่ต้องช่วยให้เมืองตัดสินใจได้ดีขึ้น':'Spatial intelligence should not only show what is happening — it should help cities decide what comes next.'}”</blockquote><div class="v2-blue-line"></div><strong>Kanlayanee Pornpatthanakulton (Bo)</strong><p>GeoDesign Manager · Urban Intelligence Specialist</p><a href={`${root}about/`}>{lang==='th'?'อ่านเพิ่มเติม':'More about me'} ↗</a></div></section>
</> : <>
<section class="container subpage-hero pt-20 md:pt-28"><p class="eyebrow muted mb-10">KP / PORTFOLIO — {String(slugs.indexOf(slug)+1).padStart(2,'0')}</p><h1 class="section-title max-w-[950px]">{slug==='about'?d.aboutTitle:slug==='projects'?d.work:slug==='writing'?d.journal:slug==='resume'?d.resume:d.research}</h1><p class="muted text-[15px] max-w-[590px] leading-8 mt-8 mb-20">{slug==='about'?d.aboutText:slug==='projects'?d.workDesc:slug==='writing'?d.journalDesc:slug==='resume'?d.pageIntro:d.researchText}</p><div class="rule"></div></section>
{slug==='about'&&<section class="container py-20"><div class="grid md:grid-cols-2 gap-12 md:gap-24"><div class="project-visual aspect-[4/5]"><img src="/images/city-hero.webp" alt="Urban intelligence digital twin illustration" class="editorial-image"/></div><div class="self-center"><p class="eyebrow mb-8">PHILOSOPHY / APPROACH</p><blockquote class="text-[clamp(30px,4vw,55px)] tracking-[-.06em] leading-[1.2]">“{d.principle}”</blockquote><div class="rule mt-16 pt-7"><p class="eyebrow mb-4">AREAS OF PRACTICE</p><p class="text-[15px] leading-9 muted">Urban Intelligence / GeoAI / Spatial Analytics / Urban Digital Twins / Geospatial Solution Architecture / Decision Support</p></div></div></div></section>}
{slug==='projects'&&<section class="container py-16 grid md:grid-cols-2 gap-x-9 gap-y-20">{d.projects.map((p,i)=><article><div class="project-visual aspect-[4/3]"><img src={`/images/${i%3===0?'project-city':i%3===1?'project-flood':'project-planning'}.webp`} alt="Concept illustration of urban intelligence work" class="editorial-image"/></div><p class="eyebrow muted mt-7">0{i+1} / {p[2]}</p><h2 class="text-[clamp(28px,3.3vw,46px)] tracking-[-.05em] mt-3">{p[0]}</h2><p class="muted mt-3 text-[15px] leading-8 max-w-[500px]">{p[1]}</p></article>)}</section>}
{slug==='writing'&&<section class="container py-16"><div class="grid md:grid-cols-2 gap-x-14">{articles.map(a=><a href={`${root}writing/${a.id.split('/').pop()}/`} class="block border-b border-[#d8dbd3] py-10 group"><p class="eyebrow muted">{a.data.category} / {a.data.date.toISOString().slice(0,10)}</p><h2 class="text-[clamp(28px,3vw,43px)] tracking-[-.055em] leading-[1.15] mt-6 group-hover:underline">{a.data.title} ↗</h2><p class="text-[14px] leading-8 muted mt-5">{a.data.description}</p><p class="eyebrow mt-8">{d.read} ↗</p></a>)}</div></section>}
{slug==='resume'&&<section class="container py-16"><div class="resume-v2"><aside><p class="eyebrow">PROFESSIONAL PROFILE</p><h2>Kanlayanee<br/>Pornpatthanakulton</h2><p class="muted">กัลยานี พรพัฒนกุลฑล (Bo)</p><p class="mt-8">GeoDesign Manager<br/>Esri (Thailand) Co., Ltd.</p><p class="mt-5 muted">Bangkok, Thailand</p><div class="rule mt-10 pt-7"><p class="eyebrow mb-5">CORE PRACTICE</p><p class="leading-8">Urban Planning · GIS · 3D GIS · Smart City Data Platforms · Digital Twins · Solution Architecture</p></div><p class="mt-8 text-sm muted">{lang==='th'?'ดาวน์โหลดเอกสารต้นฉบับที่ผู้ใช้ให้มา':'Download the supplied original resume'}</p><p class="text-[12px] muted mt-5">{lang==='th'?'รายละเอียดอ้างอิงจากประวัติบุคลากรฉบับมีนาคม 2569':'Profile based on the supplied March 2026 resume.'}</p></aside><div><p class="eyebrow mb-7">01 / {d.experience}</p>{[['2019 — Present','GeoDesign Manager','Esri (Thailand) Co., Ltd.'],['2017 — 2019','GIS Technical Consultant','Esri (Thailand) Co., Ltd.'],['2015 — 2017','GIS Technical Specialist','Esri (Thailand) Co., Ltd.'],['2013 — 2015','GIS Technical Support','Esri (Thailand) Co., Ltd.'],['2009 — 2012','Urban Designer','Axis Landscape Co., Ltd.']].map(r=><div class="resume-entry"><span>{r[0]}</span><div><h3>{r[1]}</h3><p>{r[2]}</p></div></div>)}<p class="eyebrow mt-14 mb-6">02 / {d.education}</p><div class="resume-entry"><span>2004 — 2008</span><div><h3>Bachelor's Degree · Urban & Regional Planning</h3><p>Faculty of Architecture, Chulalongkorn University</p></div></div><p class="eyebrow mt-14 mb-6">03 / CREDENTIALS</p><div class="resume-entry"><span>PROFESSIONAL</span><div><h3>Licensed Architect · Urban Design</h3><p>Architect Council of Thailand · Esri Certified ArcGIS Pro Professional (as documented in supplied resume)</p></div></div><p class="eyebrow mt-14 mb-6">04 / SELECTED ENGAGEMENTS</p>{[['2025','Thonburi Old Town Urban Regeneration','GIS and urban planning project leadership'],['2024','EEC Smart City / EECiti','GIS, 3D and urban planning solutions'],['2023','Bangkok Digital Twin','3D GIS and application design'],['2022','Flood Situation Analysis','GIS-based emergency and flood management']].map(r=><div class="resume-entry"><span>{r[0]}</span><div><h3>{r[1]}</h3><p>{r[2]}</p></div></div>)}<p class="eyebrow mt-14 mb-6">05 / PROFESSIONAL DEVELOPMENT</p><p class="leading-8 muted">Smart City Leader #4 (2021) · ArcGIS Urban (2019) · ArcGIS Pro · 3D CityEngine · GeoPython · Data Analytics for Business Growth</p><p class="eyebrow mt-14 mb-6">06 / SELECTED SPEAKING</p><p class="leading-8 muted">Smart City Data Platform (DEPA, 2024) · Smart Campus with GIS and Big Data (2024) · Thailand Smart City Expo (2023) · Digital (T)wining the Future with ArcGIS (2022) · Asia Pacific GIS User Conference (2015)</p></div></div></section>}
{slug==='research'&&<section class="container py-20"><div class="grid md:grid-cols-2 gap-20"><div class="project-visual aspect-[4/5]"><img src="/images/city-hero.webp" alt="Urban intelligence digital twin illustration" class="editorial-image"/></div><div><p class="eyebrow mb-8">RESEARCH AGENDA / 2026+</p><h2 class="text-[clamp(35px,4vw,60px)] tracking-[-.06em] leading-[1.1]">From GIS to Urban Intelligence</h2><p class="muted text-[15px] leading-9 mt-9">{d.researchText}</p><div class="rule mt-12 pt-7"><p class="eyebrow mb-6">{d.interests}</p>{['Spatial Decision Intelligence','Urban Digital Twins & Scenario Modeling','GeoAI for Urban Systems','Evidence-Based Urban Planning','Resilience & Climate Intelligence'].map((s,i)=><p class="py-4 border-b border-[#d8dbd3] text-[16px] flex gap-6"><span class="muted text-[11px]">0{i+1}</span>{s}</p>)}</div><p class="text-[12px] muted mt-9">Research interests are forward-looking. Publications and ORCID links will be added after verification.</p></div></div></section>}
</>}
</Base>
