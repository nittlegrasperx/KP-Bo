---
import Base from '../../../layouts/Base.astro';
import {getCollection,render} from 'astro:content';
import {t} from '../../../data';
export async function getStaticPaths(){const articles=await getCollection('articles');return articles.map(a=>({params:{lang:a.data.lang,slug:a.id.split('/').pop()},props:{article:a}}));}
const {lang,article}=Astro.props;const d=t[lang];const {Content}=await render(article);
---
<Base lang={lang} current="writing" title={`${article.data.title} — BO / STUDIO`} description={article.data.description}><article class="container pt-16 md:pt-24"><a href={`/${lang}/writing/`} class="text-link mb-16">← {d.back}</a><div class="max-w-[940px] mx-auto"><p class="eyebrow muted mb-8">{article.data.category} / {article.data.date.toISOString().slice(0,10)}</p><h1 class="text-[clamp(46px,7vw,100px)] tracking-[-.07em] leading-[1.03]">{article.data.title}</h1><p class="text-[clamp(18px,2vw,25px)] leading-[1.6] muted mt-10">{article.data.description}</p><div class="border-t border-b border-[#d8dbd3] flex justify-between py-5 my-14 text-[11px] tracking-widest uppercase"><span>BO / STUDIO · PERSPECTIVES</span><span>{article.data.readingTime||'5 MIN READ'}</span></div></div><div class="article-body"><Content/></div></article></Base>
