---
import '../styles/global.css';
import {t,links} from '../data';
const {lang='en',title='Urban Intelligence — Portfolio',description='Portfolio, writing and research on Urban Intelligence, GeoAI and Digital Twins.',current=''}=Astro.props;
const d=t[lang];const other=lang==='en'?'th':'en';
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="description" content={description}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta name="theme-color" content="#f7f7f3"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>{title}</title></head><body>
<header class="container flex items-center justify-between h-[68px] border-b border-[#d8dbd3]"><a href={`/${lang}/`} class="font-semibold text-[15px] tracking-[-.05em]">KP<span class="text-[#4b9deb]"> •</span></a><nav class="desktop-nav flex gap-9 items-center">{links.map((s,i)=><a class:list={['nav-link',current===s?'active':'']} href={`/${lang}/${s?`${s}/`:''}`}>{d.nav[i]}</a>)}</nav><div class="flex items-center gap-5"><a class="text-[11px] font-semibold tracking-widest" href={`/${other}/${current?`${current}/`:''}`} aria-label="Switch language">{d.switch} ↗</a><button id="menu-toggle" class="md:hidden text-[12px]" aria-expanded="false" aria-controls="mobile-menu">MENU ☰</button></div></header>
<div id="mobile-menu" class="hidden container py-6 border-b border-[#d8dbd3]">{links.map((s,i)=><a class="block py-3 text-[17px]" href={`/${lang}/${s?`${s}/`:''}`}>{d.nav[i]}</a>)}</div>
<main><slot/></main>
<footer class="bg-[#222b25] text-[#f3f5ee] mt-24"><div class="container pt-20 pb-8"><div class="grid md:grid-cols-2 gap-10 pb-24"><div><p class="eyebrow text-[#aab9a9] mb-7">CONTACT / COLLABORATION</p><h2 class="text-[clamp(42px,6vw,88px)] tracking-[-.065em] leading-[1.04] max-w-[720px]">{d.contact}</h2></div><div class="md:self-end"><p class="text-[#bac7ba] max-w-[340px] mb-8 leading-8">{d.contactText}</p><a href="mailto:contact@example.com" class="inline-block border-b border-white pb-2 text-[15px]">contact@example.com ↗</a><p class="text-[11px] mt-4 text-[#9ba99c]">Replace this placeholder with your contact email.</p></div></div><div class="border-t border-[#4a584d] pt-7 flex flex-wrap gap-4 justify-between text-[11px] text-[#b1bfb2]"><span>© {new Date().getFullYear()} KP / PORTFOLIO. {d.footer}</span><span>URBAN INTELLIGENCE · GEOAI · DIGITAL TWIN</span></div></div></footer>
<script>const btn=document.querySelector('#menu-toggle');btn?.addEventListener('click',()=>{const menu=document.querySelector('#mobile-menu');menu?.classList.toggle('hidden');btn.setAttribute('aria-expanded',String(!menu?.classList.contains('hidden')))});</script>
</body></html>
